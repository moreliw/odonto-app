generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-master"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("MASTER_DATABASE_URL")
}

enum Plan {
  FREE
  BASIC
  PRO
  CLINIC
}

enum SubscriptionStatus {
  PENDING
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentProvider {
  STRIPE
}

enum BillingInterval {
  MONTH
  YEAR
}

enum SignupIntentStatus {
  PENDING
  PROCESSING
  PROVISIONED
  FAILED
  EXPIRED
  CANCELED
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  subdomain   String   @unique
  dbName      String
  dbHost      String
  dbPort      Int      @default(5432)
  dbUser      String
  dbPassword  String
  internalNotes String?
  /// Cor primária da marca da clínica (hex, ex.: #2563eb). Nulo usa o azul padrão do produto.
  primaryColor String?
  /// URL pública do logo da clínica, exibido na sidebar e topbar do app da clínica.
  logoUrl      String?
  /// Bloqueio administrativo independente da assinatura: false suspende todo o acesso da clínica.
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subscription Subscription?
  loginIdentities LoginIdentity[]
  signupIntents   SignupIntent[]
  paymentEvents   PaymentEvent[]
  accessGrant     AccessGrant?
}

model AccessGrant {
  id            String   @id @default(uuid())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId      String   @unique
  plan          Plan
  dentistLimit  Int?
  reason        String?
  expiresAt     DateTime?
  active        Boolean  @default(true)
  stopBilling   Boolean  @default(true)
  createdBy     String
  revokedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MasterAuditLog {
  id          String   @id @default(uuid())
  actorEmail  String
  action      String
  tenantId    String?
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([action, createdAt])
}

model LoginIdentity {
  id        String  @id @default(uuid())
  email     String  @unique
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  tenantId  String
  createdAt DateTime @default(now())
}

model Subscription {
  id           String              @id @default(uuid())
  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  tenantId     String              @unique
  plan         Plan
  status       SubscriptionStatus  @default(PENDING)
  provider     PaymentProvider?
  providerCustomerId String?
  providerSubscriptionId String?   @unique
  /// Valor cobrado por ciclo (mensal ou anual, conforme billingInterval) — não é sempre um valor mensal.
  priceCents   Int
  billingInterval BillingInterval  @default(MONTH)
  currency     String              @default("BRL")
  startedAt    DateTime            @default(now())
  activatedAt  DateTime?
  lastPaymentAt DateTime?
  currentPeriodEnd DateTime?
  renewsAt     DateTime?
  canceledAt   DateTime?
  cancelAtPeriodEnd Boolean             @default(false)
}

model SignupIntent {
  id                 String            @id @default(uuid())
  clinicName         String
  clinicSlug         String
  requestedSubdomain String
  adminName          String?
  adminEmail         String
  adminPasswordHash  String
  plan               Plan
  priceCents         Int
  currency           String            @default("BRL")
  provider           PaymentProvider   @default(STRIPE)
  status             SignupIntentStatus @default(PENDING)
  providerSessionId  String?           @unique
  providerCustomerId String?
  providerSubscriptionId String?
  checkoutUrl        String?
  checkoutExpiresAt  DateTime?
  paidAt             DateTime?
  activatedAt        DateTime?
  failedReason       String?
  metadata           Json?
  tenantId           String?
  tenant             Tenant?           @relation(fields: [tenantId], references: [id])
  paymentEvents      PaymentEvent[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([adminEmail])
  @@index([clinicSlug])
  @@index([requestedSubdomain])
}

model PaymentEvent {
  id             String          @id @default(uuid())
  provider       PaymentProvider @default(STRIPE)
  externalEventId String         @unique
  type           String
  livemode       Boolean         @default(false)
  status         String          @default("RECEIVED")
  attemptCount   Int             @default(1)
  payload        Json
  error          String?
  receivedAt     DateTime        @default(now())
  processedAt    DateTime?
  tenantId       String?
  tenant         Tenant?         @relation(fields: [tenantId], references: [id])
  signupIntentId String?
  signupIntent   SignupIntent?   @relation(fields: [signupIntentId], references: [id])

  @@index([type])
  @@index([tenantId])
  @@index([signupIntentId])
}
