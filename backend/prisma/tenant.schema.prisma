generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/@prisma/client-tenant"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  DENTIST
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum ExpenseStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  BOLETO
  OTHER
}

model User {
  id            String         @id @default(uuid())
  username      String?        @unique
  email         String         @unique
  name          String
  passwordHash  String
  role          Role
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  appointments  Appointment[]  @relation("DentistAppointments")
  invoices      Invoice[]      @relation("DentistInvoices")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Patient {
  id           String        @id @default(uuid())
  name         String
  email        String?       @unique
  phone        String?
  birthDate    DateTime?
  document     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  records      Record[]
  appointments Appointment[]
  invoices     Invoice[]
  files        File[]        @relation("PatientFiles")
}

model Appointment {
  id        String            @id @default(uuid())
  patient   Patient           @relation(fields: [patientId], references: [id])
  patientId String
  dentist   User?             @relation("DentistAppointments", fields: [dentistId], references: [id], onDelete: SetNull)
  dentistId String?
  startTime DateTime
  endTime   DateTime
  status    AppointmentStatus @default(SCHEDULED)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([dentistId])
}

model Record {
  id        String   @id @default(uuid())
  patient   Patient  @relation(fields: [patientId], references: [id])
  patientId String
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model File {
  id          String   @id @default(uuid())
  patient     Patient  @relation("PatientFiles", fields: [patientId], references: [id])
  patientId   String
  key         String   @unique
  url         String
  contentType String
  size        Int
  createdAt   DateTime @default(now())
}

model Invoice {
  id          String           @id @default(uuid())
  patient     Patient          @relation(fields: [patientId], references: [id])
  patientId   String
  dentist     User?            @relation("DentistInvoices", fields: [dentistId], references: [id], onDelete: SetNull)
  dentistId   String?
  description String           @default("Cobrança odontológica")
  amount      Decimal          @db.Decimal(12, 2)
  discount    Decimal          @default(0) @db.Decimal(12, 2)
  status      InvoiceStatus    @default(PENDING)
  issuedAt    DateTime         @default(now())
  dueDate     DateTime         @default(now())
  notes       String?
  items       InvoiceItem[]
  payments    InvoicePayment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([patientId])
  @@index([dentistId])
  @@index([status, dueDate])
}

model ClinicService {
  id              String        @id @default(uuid())
  name            String
  description     String?
  category        String?
  price           Decimal       @db.Decimal(12, 2)
  durationMinutes Int?
  active          Boolean       @default(true)
  invoiceItems    InvoiceItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([active, name])
}

model InvoiceItem {
  id          String         @id @default(uuid())
  invoice     Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  service     ClinicService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceId   String?
  description String
  quantity    Int            @default(1)
  unitPrice   Decimal        @db.Decimal(12, 2)
  total       Decimal        @db.Decimal(12, 2)
  createdAt   DateTime       @default(now())

  @@index([invoiceId])
  @@index([serviceId])
}

model InvoicePayment {
  id        String        @id @default(uuid())
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  amount    Decimal       @db.Decimal(12, 2)
  paidAt    DateTime      @default(now())
  method    PaymentMethod
  notes     String?
  createdAt DateTime      @default(now())

  @@index([invoiceId])
  @@index([paidAt])
}

model Expense {
  id            String         @id @default(uuid())
  description   String
  category      String?
  supplier      String?
  amount        Decimal        @db.Decimal(12, 2)
  status        ExpenseStatus  @default(PENDING)
  issuedAt      DateTime       @default(now())
  dueDate       DateTime
  paidAt        DateTime?
  paymentMethod PaymentMethod?
  recurring     Boolean        @default(false)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, dueDate])
  @@index([paidAt])
}
