generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/@prisma/client-tenant"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  DENTIST
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ConfirmationStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum ExpenseStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  BOLETO
  OTHER
}

enum FiscalEnvironment {
  SANDBOX
  PRODUCTION
}

enum FiscalDocumentStatus {
  PROCESSING
  AUTHORIZED
  REJECTED
  ERROR
  CANCEL_PENDING
  CANCELLED
}

model User {
  id              String         @id @default(uuid())
  username        String?        @unique
  /// Nulo para um dentista cadastrado só como referência (sem acesso ao sistema).
  email           String?        @unique
  name            String
  /// Nulo junto com email — sem os dois, a conta não consegue fazer login.
  passwordHash    String?
  role            Role
  active          Boolean        @default(true)
  createdByName   String?
  updatedByName   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  /// Exceções de acesso por usuário em JSON: { "FINANCE_VIEW": true, ... }.
  accessOverrides String?
  refreshTokens   RefreshToken[]
  appointments    Appointment[]  @relation("DentistAppointments")
  invoices        Invoice[]      @relation("DentistInvoices")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Patient {
  id                    String          @id @default(uuid())
  name                  String
  email                 String?         @unique
  phone                 String?
  whatsapp              String?
  birthDate             DateTime?
  document              String?
  gender                String?
  photoUrl              String?
  postalCode            String?
  address               String?
  addressNumber         String?
  addressComplement     String?
  neighborhood          String?
  city                  String?
  state                 String?
  profession            String?
  guardianName          String?
  insuranceName         String?
  insuranceNumber       String?
  notes                 String?
  bloodType             String?
  allergies             String?
  medications           String?
  preexistingConditions String?
  medicalNotes          String?
  createdByName         String?
  updatedByName         String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  records               Record[]
  appointments          Appointment[]
  invoices              Invoice[]
  fiscalInvoices        FiscalInvoice[]
  files                 File[]          @relation("PatientFiles")
}

model Appointment {
  id                      String             @id @default(uuid())
  patient                 Patient            @relation(fields: [patientId], references: [id])
  patientId               String
  dentist                 User?              @relation("DentistAppointments", fields: [dentistId], references: [id], onDelete: SetNull)
  dentistId               String?
  /// Nome do dentista sem conta no sistema (preenchido só quando dentistId é nulo).
  dentistName             String?
  startTime               DateTime
  endTime                 DateTime
  status                  AppointmentStatus  @default(SCHEDULED)
  notes                   String?
  /// Resposta do paciente ao pedido de confirmação (link público, sem login).
  confirmationStatus      ConfirmationStatus @default(PENDING)
  confirmationToken       String?            @unique
  confirmationSentAt      DateTime?
  confirmationRespondedAt DateTime?
  createdByName           String?
  updatedByName           String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  invoices                Invoice[]

  @@index([dentistId])
}

model Record {
  id            String   @id @default(uuid())
  patient       Patient  @relation(fields: [patientId], references: [id])
  patientId     String
  content       Json
  createdByName String?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model File {
  id             String   @id @default(uuid())
  patient        Patient  @relation("PatientFiles", fields: [patientId], references: [id])
  patientId      String
  key            String   @unique
  url            String
  contentType    String
  size           Int
  originalName   String?
  category       String?
  notes          String?
  uploadedByName String?
  createdAt      DateTime @default(now())
}

model RoleAccessPolicy {
  id            String   @id @default(uuid())
  role          Role     @unique
  /// Lista JSON das permissões concedidas ao perfil.
  permissions   String
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Invoice {
  id             String           @id @default(uuid())
  patient        Patient          @relation(fields: [patientId], references: [id])
  patientId      String
  /// Consulta que originou a cobrança. O histórico financeiro é preservado se a agenda for excluída.
  appointment    Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  appointmentId  String?
  dentist        User?            @relation("DentistInvoices", fields: [dentistId], references: [id], onDelete: SetNull)
  dentistId      String?
  /// Nome do dentista sem conta no sistema (preenchido só quando dentistId é nulo).
  dentistName    String?
  description    String           @default("Cobrança odontológica")
  amount         Decimal          @db.Decimal(12, 2)
  discount       Decimal          @default(0) @db.Decimal(12, 2)
  status         InvoiceStatus    @default(PENDING)
  issuedAt       DateTime         @default(now())
  dueDate        DateTime         @default(now())
  notes          String?
  items          InvoiceItem[]
  payments       InvoicePayment[]
  fiscalInvoices FiscalInvoice[]
  createdByName  String?
  updatedByName  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([patientId])
  @@index([appointmentId])
  @@index([dentistId])
  @@index([status, dueDate])
}

/// Configuração fiscal da clínica. Existe uma única linha (id = "default") por banco/tenant.
/// Credenciais da software house ficam apenas em variáveis de ambiente; certificados e senhas
/// são enviados diretamente ao provedor fiscal e nunca são persistidos aqui.
model FiscalSettings {
  id                         String             @id @default("default")
  enabled                    Boolean            @default(false)
  environment                FiscalEnvironment  @default(PRODUCTION)
  providerMode               String             @default("NATIONAL")
  taxId                      String?
  municipalRegistration      String?
  stateRegistration          String?
  legalName                  String?
  tradeName                  String?
  email                      String?
  phone                      String?
  postalCode                 String?
  street                     String?
  number                     String?
  complement                 String?
  neighborhood               String?
  city                       String?
  state                      String?
  cityCode                   String?
  simpleNationalOption       Int                @default(3)
  simpleNationalTaxRegime    Int                @default(1)
  specialTaxRegime           Int                @default(0)
  fiscalIncentive            Boolean            @default(false)
  rpsSeries                  String             @default("1")
  rpsBatch                   Int                @default(1)
  rpsNumber                  Int                @default(1)
  defaultNationalTaxCode     String?
  defaultMunicipalTaxCode    String?
  defaultCnae                String?
  defaultNbs                 String?
  defaultIssRate             Decimal?           @db.Decimal(7, 4)
  defaultIssWithheld         Boolean            @default(false)
  providerCompanySyncedAt    DateTime?
  providerCompanyEnvironment FiscalEnvironment?
  providerCompanyTaxId       String?
  certificateExpiresAt       DateTime?
  certificateEnvironment     FiscalEnvironment?
  certificateTaxId           String?
  certificateSubject         String?
  updatedByName              String?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
}

/// NFS-e emitida a partir de uma cobrança. Os snapshots preservam o documento mesmo que os
/// dados cadastrais do paciente ou a cobrança sejam alterados posteriormente.
model FiscalInvoice {
  id                 String               @id @default(uuid())
  invoice            Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId          String?
  patient            Patient?             @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientId          String?
  provider           String               @default("NUVEM_FISCAL")
  providerId         String?              @unique
  reference          String               @unique
  environment        FiscalEnvironment
  status             FiscalDocumentStatus @default(PROCESSING)
  number             String?
  verificationCode   String?
  accessKey          String?
  publicUrl          String?
  serviceDate        DateTime
  serviceDescription String
  amount             Decimal              @db.Decimal(12, 2)
  nationalTaxCode    String
  municipalTaxCode   String?
  cnae               String?
  nbs                String?
  issRate            Decimal?             @db.Decimal(7, 4)
  issWithheld        Boolean              @default(false)
  customerName       String
  customerDocument   String
  customerEmail      String?
  customerSnapshot   Json
  requestPayload     Json
  providerResponse   Json?
  lastMessage        String?
  issuedAt           DateTime?
  cancelledAt        DateTime?
  createdByName      String?
  updatedByName      String?
  events             FiscalEvent[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([invoiceId])
  @@index([patientId])
  @@index([status, createdAt])
}

model FiscalEvent {
  id               String        @id @default(uuid())
  fiscalInvoice    FiscalInvoice @relation(fields: [fiscalInvoiceId], references: [id], onDelete: Cascade)
  fiscalInvoiceId  String
  action           String
  status           String?
  message          String?
  providerResponse Json?
  createdByName    String?
  createdAt        DateTime      @default(now())

  @@index([fiscalInvoiceId, createdAt])
}

model ClinicService {
  id              String        @id @default(uuid())
  name            String
  description     String?
  category        String?
  price           Decimal       @db.Decimal(12, 2)
  durationMinutes Int?
  active          Boolean       @default(true)
  createdByName   String?
  updatedByName   String?
  invoiceItems    InvoiceItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([active, name])
}

model InvoiceItem {
  id          String         @id @default(uuid())
  invoice     Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  service     ClinicService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceId   String?
  description String
  quantity    Int            @default(1)
  unitPrice   Decimal        @db.Decimal(12, 2)
  total       Decimal        @db.Decimal(12, 2)
  createdAt   DateTime       @default(now())

  @@index([invoiceId])
  @@index([serviceId])
}

model InvoicePayment {
  id        String        @id @default(uuid())
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  amount    Decimal       @db.Decimal(12, 2)
  paidAt    DateTime      @default(now())
  method    PaymentMethod
  notes     String?
  createdAt DateTime      @default(now())

  @@index([invoiceId])
  @@index([paidAt])
}

model Expense {
  id            String         @id @default(uuid())
  description   String
  category      String?
  supplier      String?
  amount        Decimal        @db.Decimal(12, 2)
  status        ExpenseStatus  @default(PENDING)
  issuedAt      DateTime       @default(now())
  dueDate       DateTime
  paidAt        DateTime?
  paymentMethod PaymentMethod?
  recurring     Boolean        @default(false)
  notes         String?
  createdByName String?
  updatedByName String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, dueDate])
  @@index([paidAt])
}
