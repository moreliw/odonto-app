APP_ENV=development
POSTGRES_USER=odonto_dev
POSTGRES_PASSWORD=gere-uma-senha-diferente-da-producao
POSTGRES_DB=master_dev
MASTER_DATABASE_URL=postgresql://odonto_dev:senha@postgres-master-dev:5432/master_dev?schema=public
JWT_SECRET=gere-um-segredo-de-desenvolvimento
JWT_REFRESH_SECRET=gere-outro-segredo-de-desenvolvimento
REDIS_URL=redis://redis-dev:6379
S3_ENDPOINT=https://odontoapp-dev.morelidev.com
S3_ACCESS_KEY=odonto_dev_files
S3_SECRET_KEY=gere-uma-senha-de-desenvolvimento
S3_BUCKET=odonto-files-dev
PUBLIC_APP_URL=https://odontoapp-dev.morelidev.com
PUBLIC_DOMAIN=odontoapp-dev.morelidev.com
PUBLIC_WILDCARD=false
ALLOW_FREE_SIGNUP=true
STRIPE_TRIAL_DAYS=7
STRIPE_EXPECTED_LIVEMODE=false
# Use somente chaves sk_test_/whsec_ e Prices de teste neste ambiente.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_CLINIC_MONTHLY=
APP_HTTP_PORT=8087
LOG_LEVEL=debug
LOG_TO_FILE=false
MASTER_ADMIN_TOKEN=
MASTER_SUPERADMIN_EMAIL=
MASTER_SUPERADMIN_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Preencha somente quando precisar validar a integração oficial de NFS-e.
